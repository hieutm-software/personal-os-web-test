# -----------------------------------------------------------------------------
# APPLICATION ENVIRONMENT TEMPLATE
# Note: Wrap all config strings containing special characters in single quotes.
# -----------------------------------------------------------------------------

# [DATABASE] Neon Serverless Postgres
# Required by Drizzle ORM and drizzle-kit for connection and migrations
DATABASE_URL='postgresql://<username>:<password>@<host>/<database>?sslmode=require'

# [AUTHENTICATION] Edge JWT Auth
# Required by 'jose' for signing and verifying secure HTTP-only cookies
# Recommendation: Generate via `openssl rand -base64 32`
JWT_SECRET='your_super_secure_jwt_secret_key_replace_me_in_production'

# [CORE] Application Constants
NEXT_PUBLIC_APP_URL='http://localhost:3000'

# [SUPABASE] Storage
NEXT_PUBLIC_SUPABASE_URL='https://your-project.supabase.co'
NEXT_PUBLIC_SUPABASE_ANON_KEY='your_anon_key'
SUPABASE_SERVICE_ROLE_KEY='your_service_role_key'

# [ADMIN & CRON] System Security
# Fallback admin password required for critical tasks like seeding the database
SUDO_PASSWORD='your_strong_admin_sudo_password'

# Secret required to trigger Vercel Cron jobs securely (/api/cron/overdue)
CRON_SECRET='your_secure_cron_secret'